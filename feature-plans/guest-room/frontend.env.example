# Server-only. Never prefix these with NEXT_PUBLIC_.
GUEST_INTERNAL_URL=http://127.0.0.1:4000/internal/guest
GUEST_PROXY_SECRET=
# Set only after ingress overwrites this header and direct Next access is blocked.
GUEST_TRUSTED_IP_HEADER=x-guest-client-ip
# Existing NextAuth deployment settings must point at the canonical origin.
NEXTAUTH_URL=https://workdash.site
# Public Turnstile site key, baked into the frontend build.
NEXT_PUBLIC_GUEST_TURNSTILE_SITE_KEY=
