# Google OAuth (NextAuth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth
NEXTAUTH_URL=http://localhost:8080
NEXTAUTH_SECRET=your-nextauth-secret

# Client-side (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SFU_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_GIPHY_PICKER=your-giphy-api-key

# Self-hosted Umami analytics. Leave unset and no analytics script loads.
# NEXT_PUBLIC_UMAMI_URL=https://analytics.workdash.site
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
